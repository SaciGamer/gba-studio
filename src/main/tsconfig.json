{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "rootDir": ".",
    "baseUrl": ".",
    "outDir": "../../dist/main",
    "noEmit": false,
    "allowJs": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./*"] 
    }
  },
  "include": [
    // "vite.config.ts",
    "./**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}