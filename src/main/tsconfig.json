{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "rootDir": "..",
    "baseUrl": "..",
    "outDir": "../../dist",
    "noEmit": false,
    "allowJs": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["main/*"] 
    }
  },
  "include": [
    // "vite.config.ts",
    "./**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}