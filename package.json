{
  "name": "gba-studio",
  "author": "GBA Studio",
  "productName": "GBA Studio",
  "description": "Project for creating and compiling GBA",
  "version": "0.4.1",
  "license": "GPL-2.0 license",
  "private": true,
  "type": "module",
  "main": "./dist/main/main.js",
  "_moduleAliases": {
    "@": "./dist/main"
  },
  "workspaces": [
    "src/renderer/frontend",
    "src/main"
  ],
  "build": {
    "appId": "com.gba-studio.app",
    "productName": "GBA Studio",
    "artifactName": "gba-studio-${os}-${arch}.${ext}",
    "directories": {
      "output": "release/${version}",
      "buildResources": "icon"
    },
    "extraResources": [
      {
        "from": "bin/",
        "to": "bin",
        "filter": ["**/*"]
      },
      {
        "from": "tools/devkitPro",
        "to": "bin/tools/devkitPro",
        "filter": ["**/*"]
      },
      {
        "from": "tools/butano/",
        "to": "bin/tools/butano",
        "filter": ["**/*"]
      },
      {
        "from": "src/renderer/frontend/public/emulatorjs/data",
        "to": "bin/tools/emulatorjs/data",
        "filter": ["**/*"]
      }
    ],
    "files": [
      "!**/test/**",
      "!**/*.md",
      "dist/**/*",
      "icon/**/*",
      "sample_project_example",
      "package.json"
    ],
    "mac": {
      "icon": "icon/defaultIcon.icns",
      "artifactName": "gba-studio-macos-${arch}-installer.${ext}",
      "target": ["dmg", "zip"]
    },
    "win": {
      "icon": "icon/defaultIcon.ico",
      "artifactName": "gba-studio-windows-${arch}-installer.${ext}",
      "target": ["nsis", "portable", "zip"],
      "signAndEditExecutable": true
    },
    "linux": {
      "icon": "icon/defaultImgIcon.png",
      "artifactName": "gba-studio-linux-${arch}-installer.${ext}",
      "target": ["snap", "deb", "AppImage"]
    },
    "portable": {
      "artifactName": "gba-studio-${os}-${arch}-standalone.${ext}"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/express/**"
    ]
  },
  "scripts": {
    "start": "concurrently \"yarn workspace @gba-studio/frontend dev\" \"wait-on --httpTimeout 5000 http://localhost:5173 && electron .\"",
    "dev": "concurrently \"yarn workspace @gba-studio/frontend dev\" \"wait-on --httpTimeout 5000 http://localhost:5173 && electron .\"",
    "compile-scripts": "tsc -p scripts/tsconfig.scripts.json",
    "prebuild": "node scripts-dist/setupMagick.js",
    "prebuild:main": "node scripts-dist/setupMagick.js win64",
    "clean": "rm -rf dist",

    "build": "yarn clean && yarn build:main && yarn build:renderer",
    "build:main": "yarn workspace @gba-studio/main build",
    "build:renderer": "yarn workspace @gba-studio/frontend build",
    
    "build:win32": "yarn clean && node scripts-dist/setupMagick.js win32 && yarn build:main && yarn build:renderer && electron-builder --win --ia32",
    "build:win64": "yarn clean && node scripts-dist/setupMagick.js win64 && yarn build:main && yarn build:renderer && electron-builder --win --x64",
    "build:linux": "yarn clean && node scripts-dist/setupMagick.js linux && yarn build:main && yarn build:renderer && electron-builder --linux",
    "build:mac": "yarn clean && nonode scripts-dist/setupMagick.js darwin && yarn build:main && yarn build:renderer && electron-builder --mac",
    
    "preview": "yarn workspace @gba-studio/frontend preview && electron ."
  },
  "dependencies": {
    "antd": "^6.3.3",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.0",
    "decompress": "^4.2.1",
    "electron-is-dev": "^3.0.1",
    "electron-store": "^10.0.1",
    "electron-window-state": "^5.0.3",
    "express": "^5.2.1",
    "https-browserify": "^1.0.0",
    "imagemagick": "^0.1.3",
    "node-7z": "^3.0.0",
    "os-browserify": "^0.3.0",
    "process": "^0.11.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "url": "^0.11.4",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.24.7",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/electron-store": "^3.2.0",
    "@types/node": "^20.11.19",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.1.1",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.23",
    "tailwindcss": "^3.3.2",
    "typescript": "^5.2.2",
    "vite": "^5.1.0",
    "wait-on": "^8.0.2"
  }
}
