{
  "name": "gba-studio",
  "version": "1.0.0",
  "description": "Project for creating and compiling GBA",
  "main": "main.mjs",
  "type": "module",
  "build": {
    "icon": "icon/defaultImgIcon.png",
    "win": {
      "icon": "icon/defaultIcon.ico"
    }
  },
  "scripts": {
    "start": "concurrently \"cd frontend && npm start\" \"wait-on http://localhost:3000 && electron . --enable-logging\"",
    "start:react": "cd frontend && npm start",
    "build": "cd frontend && npm run build",
    "electron": "wait-on http://localhost:3000 && electron .",
    "test": "cd frontend && npm test",
    "eject": "cd frontend && npm run eject",
    "build-gba": "cd gba-project && make rebuild && cd .."
  },
  "keywords": [],
  "author": "sacigamer.dev@gmail.com",
  "license": "ISC",
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "concurrently": "^6.2.0",
    "electron": "^32.1.0",
    "wait-on": "^6.0.0"
  },
  "dependencies": {
    "electron-is-dev": "^3.0.1",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "react-scripts": "^5.0.1"
  }
}
